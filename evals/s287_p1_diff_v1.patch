+def _replace_policy() -> bool:
+    """El brazo del seam 1 (IDENTITY_RESOLVE_POLICY): 'add' (default) | 'replace'."""
+    return (os.getenv("IDENTITY_RESOLVE_POLICY", "") or "add").strip().lower() == "replace"
